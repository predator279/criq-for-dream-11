# CricIQ — local secrets template
#
# 1. Copy this file to `.env.local` (same folder).
# 2. Paste your keys after the `=`.
# 3. Restart `npm run dev`.
#
# `.env.local` is gitignored and is read only by the local dev server.
# On Vercel these same names go in Settings → Environment Variables instead.

# Primary AI provider (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Fallback AI provider, used when Gemini rate-limits (free tier: https://console.groq.com/keys)
GROQ_API_KEY=

# Optional live scores (free tier: https://cricketdata.org). Without it the app
# runs the scripted demo and says so in the footer.
CRICAPI_API_KEY=
